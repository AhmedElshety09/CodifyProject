# =========================================================================
#  .env — the SINGLE source of configuration (copy to `.env` and edit)
# =========================================================================
# conftest.py loads this file at startup. NOTHING is hard-coded in code;
# every setting below is read here. `.env` is git-ignored (keep secrets local);
# `.env.example` is the safe committed template.
# =========================================================================

# --- App under test (REQUIRED) -------------------------------------------
MV_BASE_URL=https://example.com

# --- Login (only used by tests that have a login precondition) -----------
MV_USER=super_admin
MV_PASS=CHANGE_ME

# --- Browser --------------------------------------------------------------
MV_BROWSER=chromium          # chromium | firefox | webkit
MV_HEADLESS=false            # true = run in background (no visible window)
MV_VIEWPORT_W=1440
MV_VIEWPORT_H=900

# --- Timeouts (milliseconds) ---------------------------------------------
MV_T_ACTION=15000            # click / fill / press
MV_T_NAV=30000               # page loads
MV_T_EXPECT=10000            # waiting for an expected condition
MV_WAIT_UNTIL=load           # load | domcontentloaded | networkidle

# --- Video ----------------------------------------------------------------
MV_VIDEO=true                # record video (mandatory by default)
MV_VIDEO_NAME=run.webm

# --- Failure screenshot ---------------------------------------------------
# On failure a full-page screenshot is taken, but capped to this height (px)
# so long pages don't produce a giant image. On pass, a normal shot is taken.
MV_FAIL_SHOT_MAX_H=2400

# --- Failure logs (written ONLY on failure -> Logs/) ---------------------
# Caps keep the diagnostic bundle small and safe.
MV_LOG_MAX_CONSOLE=20        # max console errors/warnings kept
MV_LOG_MAX_NETWORK=20        # max failed (4xx/5xx/failed) requests kept
MV_LOG_MAX_TB_LINES=15       # traceback tail lines kept
